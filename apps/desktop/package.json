{
  "name": "gzhu-cup2-pet",
  "private": true,
  "version": "1.3.2",
  "description": "心伴（XinBan）桌宠桌面端（Electron）——独立窗口形态的桌宠前端，只调用既有后端 API",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dev:electron": "vite build && electron .",
    "backend": "uv run python ../../packaging/build_backend.py",
    "dist": "npm run build && npm run backend && electron-builder --win",
    "dist:only": "electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "com.xinban.pet",
    "productName": "心伴",
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../../pet/assets", "to": "pet-assets" },
      { "from": "../../pet/cards", "to": "card-seed" },
      { "from": "../web/dist", "to": "frontend-dist" },
      { "from": "backend-dist/gzhu-backend", "to": "backend" },
      { "from": "assets/tray.png", "to": "tray.png" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "shortcutName": "心伴",
      "artifactName": "XinBan-Setup-${version}.${ext}"
    }
  }
}
